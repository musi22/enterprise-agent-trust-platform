# ==============================================================================
# Agentic Commerce Reliability & Recovery Lab - Environment Configuration
# ==============================================================================

# Project & App Environment
PROJECT_NAME="Agentic Commerce Reliability & Recovery Lab"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Database (Default: local SQLite async, or PostgreSQL for Docker)
DATABASE_URL="sqlite+aiosqlite:///./commerce_lab.db"
# DATABASE_URL="postgresql+asyncpg://lab_user:lab_password@localhost:5432/commerce_lab"

# Security & JWT
JWT_SECRET_KEY="super-secret-enterprise-agent-lab-jwt-token-key-32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Model Provider (Default: 100% offline deterministic mock)
DEFAULT_MODEL_PROVIDER="deterministic_mock"

# Optional External Providers (NOT required for benchmark or tests)
# GEMINI_API_KEY="your-gemini-api-key"
# OPENAI_API_KEY="your-openai-api-key"
# OLLAMA_BASE_URL="http://localhost:11434"

# Resilience & Policy Constraints
REFUND_APPROVAL_THRESHOLD_CENTS=5000
MAX_RECOVERY_RETRIES=3
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=15

# Global Deterministic Seed
GLOBAL_RANDOM_SEED=42
